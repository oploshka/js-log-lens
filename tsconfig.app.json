{
  "extends": [
    "@vue/tsconfig/tsconfig.dom.json",
    "./tsconfig.paths.json"
  ],
  "compilerOptions": {
    "types": [
      "vite/client"
    ],
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/**/*.js",
    "src/**/*.ts",
    "test/**/*.ts",
    "test/**/*.js",
    "test/**/*.vue",
    "example/**/*.ts",
    "example/**/*.js"
  ]
}
