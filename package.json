{
  "name": "js-log-lens",
  "version": "0.0.0",
  "private": true,
  "description": "Configurable JavaScript logger with contextual metadata, flexible filtering, and PSR-3 severity levels.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oploshka/js-log-lens.git"
  },
  "bugs": {
    "url": "https://github.com/oploshka/js-log-lens/issues"
  },
  "homepage": "https://oploshka.github.io/js-log-lens/",
  "keywords": [
    "logger",
    "logging",
    "javascript",
    "metadata",
    "psr-3"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "serve": "vite --config vite.demo.config.ts",
    "build": "pnpm build:library",
    "build:library": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pack:check": "pnpm build:library && npm pack --dry-run --ignore-scripts",
    "test": "pnpm build:library && node --test test/unit/*.test.mjs",
    "build:pages": "vite build --config vite.demo.config.ts --mode ph-pages"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^10.12.0",
    "eslint-plugin-oploshka": "^10.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  },
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "packageManager": "pnpm@12.18.0"
}
